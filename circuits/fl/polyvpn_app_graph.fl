// ═══════════════════════════════════════════════════════════════════════════════
// Graph Registration
// ═══════════════════════════════════════════════════════════════════════════════

/// Register all 11 PolyVPN modules and their intra-graph REQUIRES
/// dependency edges into the provided CsrStorage graph.
circuit polyvpn_app_graph_register(
    graph: CsrStorage
) -> CsrStorage
    lex polylabs/polyvpn
    @status production
    @precision B
    @attested true
    invariant "capacity" { graph.num_nodes + POLYVPN_MODULE_COUNT as u32 <= 4096 }
    observe metrics: [registered_module_count, registered_edge_count]
    meters [compute_cycles, memory_bytes]
{
    // ── Add all 11 modules ──────────────────────────────────────────────────
    let (g, id_dns)             = module_graph_add_module(graph, polyvpn_dns_module())
    let (g, id_encrypt)         = module_graph_add_module(g, polyvpn_encrypt_module())
    let (g, id_incognito)       = module_graph_add_module(g, polyvpn_incognito_module())
    let (g, id_killswitch)      = module_graph_add_module(g, polyvpn_killswitch_module())
    let (g, id_metering)        = module_graph_add_module(g, polyvpn_metering_module())
    let (g, id_mimicry)         = module_graph_add_module(g, polyvpn_mimicry_module())
    let (g, id_platform_health) = module_graph_add_module(g, polyvpn_platform_health_module())
    let (g, id_rbac)            = module_graph_add_module(g, polyvpn_rbac_module())
    let (g, id_scatter)         = module_graph_add_module(g, polyvpn_scatter_module())
    let (g, id_exit_graph)      = module_graph_add_module(g, polyvpn_exit_graph_module())
    let (g, id_route_dag)       = module_graph_add_module(g, polyvpn_route_dag_module())

    let vc = ">=" ++ POLYVPN_VERSION_STR

    // ── Intra-graph REQUIRES edges ──────────────────────────────────────────
    // scatter -> route_dag (multi-hop path selection)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyvpn_scatter",
        source_version: POLYVPN_VERSION_STR, target_module: "route_dag",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_scatter, id_route_dag)

    // scatter -> exit_graph (exit node selection)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyvpn_scatter",
        source_version: POLYVPN_VERSION_STR, target_module: "exit_graph",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_scatter, id_exit_graph)

    // scatter -> encrypt (per-hop onion encryption)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyvpn_scatter",
        source_version: POLYVPN_VERSION_STR, target_module: "polyvpn_encrypt",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_scatter, id_encrypt)

    // mimicry -> encrypt (camouflaged tunnel wrapping)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyvpn_mimicry",
        source_version: POLYVPN_VERSION_STR, target_module: "polyvpn_encrypt",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_mimicry, id_encrypt)

    // dns -> encrypt (encrypted DNS resolution)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyvpn_dns",
        source_version: POLYVPN_VERSION_STR, target_module: "polyvpn_encrypt",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_dns, id_encrypt)

    // incognito -> encrypt (ephemeral session establishment)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyvpn_incognito",
        source_version: POLYVPN_VERSION_STR, target_module: "polyvpn_encrypt",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_incognito, id_encrypt)

    // killswitch -> scatter (tunnel state monitoring)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyvpn_killswitch",
        source_version: POLYVPN_VERSION_STR, target_module: "polyvpn_scatter",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_killswitch, id_scatter)

    // metering -> scatter (relay hop accounting)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyvpn_metering",
        source_version: POLYVPN_VERSION_STR, target_module: "polyvpn_scatter",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_metering, id_scatter)

    // platform_health -> exit_graph (exit node health overlay)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyvpn_platform_health",
        source_version: POLYVPN_VERSION_STR, target_module: "exit_graph",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_platform_health, id_exit_graph)

    // platform_health -> route_dag (path health scoring)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyvpn_platform_health",
        source_version: POLYVPN_VERSION_STR, target_module: "route_dag",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_platform_health, id_route_dag)

    g
}

// ═══════════════════════════════════════════════════════════════════════════════
// Cross-Graph Bridge Edges — PolyKit + eStream
// ═══════════════════════════════════════════════════════════════════════════════

/// Register EDGE_BRIDGE_TO edges linking PolyVPN's incognito module to
/// PolyKit incognito and scatter module to eStream scatter routing.
circuit polyvpn_register_bridge_edges(
    graph: CsrStorage
) -> CsrStorage
    lex polylabs/polyvpn
    @status production
    @precision B
    @attested true
    observe metrics: [bridge_count]
    meters [compute_cycles]
{
    let incognito_id = find_poly_module_id(graph, "polyvpn_incognito")
    let scatter_id = find_poly_module_id(graph, "polyvpn_scatter")

    let g = graph

    // polyvpn_incognito -> PolyKit incognito bridge
    if incognito_id != 0xFFFFFFFF as u32 {
        let incognito_bridge = InterAppEdge {
            edge_type: EDGE_BRIDGE_TO,
            source_lex: POLYVPN_APP_LEX,
            source_module: "polyvpn_incognito",
            target_lex: "polylabs/polykit",
            target_module: "polykit_incognito",
            bridge_scope: BridgeScope::Platform as u8,
            shared_fields: ["ephemeral_spark_id", "session_unlinkability_proof", "identity_rotation_schedule"],
            redacted_fields: [],
            bilateral_confirmed: false,
        }
        g = module_graph_add_bridge_edge(g, incognito_bridge, incognito_id)
    }

    // polyvpn_scatter -> eStream scatter routing bridge
    if scatter_id != 0xFFFFFFFF as u32 {
        let scatter_bridge = InterAppEdge {
            edge_type: EDGE_BRIDGE_TO,
            source_lex: POLYVPN_APP_LEX,
            source_module: "polyvpn_scatter",
            target_lex: "estream/scatter",
            target_module: "scatter_routing",
            bridge_scope: BridgeScope::Platform as u8,
            shared_fields: ["route_dag_snapshot", "relay_health_vector", "hop_count"],
            redacted_fields: [],
            bilateral_confirmed: false,
        }
        g = module_graph_add_bridge_edge(g, scatter_bridge, scatter_id)
    }

    g
}

// ═══════════════════════════════════════════════════════════════════════════════
// Internal Helpers
// ═══════════════════════════════════════════════════════════════════════════════

circuit find_polyvpn_module_id(graph: CsrStorage, name: string) -> u32
    lex polylabs/polyvpn
    @status production
    @precision D
{
    find_poly_module_id(graph, name)
}

// ── Metrics Store ──────────────────────────────────────────────────────────────

store series polyvpn_app_graph_metrics
    lex polylabs/polyvpn/metrics
{
    operation: string key
    product_name: string
    module_count: u32
    edge_count: u32
    bridge_count: u32
    register_latency_ns: u64
}

// ── Golden Tests ───────────────────────────────────────────────────────────────

test golden "polyvpn_app_graph_registers_11_modules" {
    exec {
        let g = graph_create()
        let g = polyvpn_app_graph_register(g)
    }
    assert {
        g.num_nodes == 11
        g.num_edges == 10
        find_poly_module_id(g, "polyvpn_dns") != 0xFFFFFFFF
        find_poly_module_id(g, "polyvpn_encrypt") != 0xFFFFFFFF
        find_poly_module_id(g, "polyvpn_incognito") != 0xFFFFFFFF
        find_poly_module_id(g, "polyvpn_killswitch") != 0xFFFFFFFF
        find_poly_module_id(g, "polyvpn_metering") != 0xFFFFFFFF
        find_poly_module_id(g, "polyvpn_mimicry") != 0xFFFFFFFF
        find_poly_module_id(g, "polyvpn_platform_health") != 0xFFFFFFFF
        find_poly_module_id(g, "polyvpn_rbac") != 0xFFFFFFFF
        find_poly_module_id(g, "polyvpn_scatter") != 0xFFFFFFFF
        find_poly_module_id(g, "exit_graph") != 0xFFFFFFFF
        find_poly_module_id(g, "route_dag") != 0xFFFFFFFF
    }
}

test golden "polyvpn_bridge_edges_connect_polykit_estream" {
    exec {
        let g = graph_create()
        let g = polyvpn_app_graph_register(g)
        let g = polyvpn_register_bridge_edges(g)
    }
    assert {
        g.num_nodes == 11 + 2
        let incognito_id = find_poly_module_id(g, "polyvpn_incognito")
        incognito_id != 0xFFFFFFFF
        let scatter_id = find_poly_module_id(g, "polyvpn_scatter")
        scatter_id != 0xFFFFFFFF
    }
}

test golden "make_polyvpn_module_creates_valid_node" {
    let node = make_polyvpn_module("polyvpn_test",
        AperturePartition::Backend as u8,
        SLATier::Standard as u8,
        ResourceBudget8D {
            execution: 5000, hash_ops: 200, bandwidth: 2000,
            storage: 1000, observe_events: 100, proofs: 10,
            consensus: 5, memory: 4096,
        })
    assert node.name == "polyvpn_test"
    assert node.version_major == POLYVPN_VERSION_MAJOR
    assert node.version_minor == POLYVPN_VERSION_MINOR
    assert node.resource_budget.execution == 5000
    assert node.state == ModuleState::Active as u8
    assert node.sla_tier == SLATier::Standard as u8
}

// ── Extern ─────────────────────────────────────────────────────────────────────

extern "rust" {
    #[module = "estream_runtime"]
    #[api = "graph"]
    #[state = "os"]
    fn graph_create() -> CsrStorage
}
