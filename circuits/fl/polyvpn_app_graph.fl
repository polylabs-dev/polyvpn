    observe metrics: [module_init]  meters [compute_cycles]
{
    make_polyvpn_module("polyvpn_dns", AperturePartition::Backend as u8,
        SLATier::Premium as u8, ResourceBudget8D {
            execution: 120000, hash_ops: 3000, bandwidth: 40000,
            storage: 20000, observe_events: 6000, proofs: 80,
            consensus: 20, memory: 16777216,
        })
}

