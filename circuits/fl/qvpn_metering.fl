// Q VPN Metering — Per-product 8D metering for VPN operations (v0.12.0)
//
// Maps VPN operations to QKit metering dimensions.
// Isolated under polyqlabs.vpn.metering lex — no cross-product aggregation.
//
// Operation          | Dimensions
// -------------------|------------------------------------
// tunnel             | Bandwidth, Executions, Hashes
// dns                | Executions, Observables
// mimicry            | Executions, Circuits
// distribute            | Bandwidth, Hashes
// incognito          | Executions, Circuits, Hashes

import qkit_metering

// --- Meter tunnel bandwidth and packet operations ---
circuit meter_tunnel(
    user_id: bytes(16),
    bytes_transferred: u64,
    packets: u64,
) -> MeteringRecord
    profile poly_framework_standard
    lex global/org/polyqlabs/vpn/metering
    @precision C
    @observe metrics: [tunnel_metering_events]
    monitor "tunnel_metering_rate" { tunnel_metering_events < 5000/s }
    meters [compute_cycles]
    test golden "meter_tunnel_basic" {
        let uid = bytes(16, 0x01)
        let record = meter_tunnel(uid, 1024, 10)
        assert record != null
    }
{
    qkit_metering::record_usage(user_id, "vpn_tunnel", DimensionValues {
        executions: packets,
        hashes: packets,
        bandwidth: bytes_transferred,
        storage: 0,
        observables: 0,
        proofs: 0,
        circuits: 0,
        mpc_sessions: 0,
    })
}

// --- Meter DNS query volume ---
circuit meter_dns(
    user_id: bytes(16),
    queries: u64,
    blocked: u64,
) -> MeteringRecord
    profile poly_framework_standard
    lex global/org/polyqlabs/vpn/metering
    @precision C
    @observe metrics: [dns_metering_events]
    meters [compute_cycles]
{
    qkit_metering::record_usage(user_id, "vpn_dns", DimensionValues {
        executions: queries,
        hashes: 0,
        bandwidth: 0,
        storage: 0,
        observables: queries + blocked,
        proofs: 0,
        circuits: 0,
        mpc_sessions: 0,
    })
}

