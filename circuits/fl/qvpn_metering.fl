// --- Meter incognito mode operations ---
circuit meter_incognito(
    user_id: bytes(16),
    sessions_activated: u64,
    profile_switches: u64,
) -> MeteringRecord
    profile poly_framework_standard
    lex global/org/polyqlabs/vpn/metering
    @precision C
    @observe metrics: [incognito_metering_events]
    meters [compute_cycles]
{
    qkit_metering::record_usage(user_id, "vpn_incognito", DimensionValues {
        executions: sessions_activated,
        hashes: sessions_activated,
        bandwidth: 0,
        storage: 0,
        observables: 0,
        proofs: 0,
        circuits: profile_switches,
        mpc_sessions: 0,
    })
}

// --- Check aggregate VPN usage against tier limits ---
circuit check_vpn_limits(
    user_id: bytes(16),
    tier_name: string,
    tier_limits: TierLimits,
) -> list<MeteringDimension>
    profile poly_framework_standard
    lex global/org/polyqlabs/vpn/metering
    @precision C
    @observe metrics: [limit_checks, limit_violations]
    meters [compute_cycles]
{
    let current = qkit_metering::get_usage_summary(user_id)
    qkit_metering::check_limits(current, tier_limits)
}
