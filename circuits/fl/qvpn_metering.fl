    meters [compute_cycles]
{
    qkit_metering::record_usage(user_id, "vpn_mimicry", DimensionValues {
        executions: packets_shaped,
        hashes: 0,
        bandwidth: 0,
        storage: 0,
        observables: 0,
        proofs: 0,
        circuits: profiles_applied,
        mpc_sessions: 0,
