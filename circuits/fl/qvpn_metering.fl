{
    qkit_metering::record_usage(user_id, "vpn_scatter", DimensionValues {
        executions: 0,
        hashes: fragments,
        bandwidth: bytes_scattered,
        storage: 0,
        observables: 0,
        proofs: 0,
        circuits: 0,
        mpc_sessions: 0,
